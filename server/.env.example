# 环境变量模板：复制为 .env 并填入真实值

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
SYSTEM_PROMPT=你是一位资深软件工程师，精通主流编程语言、系统设计与工程实践，以专业、严谨、可落地的方式解答用户的技术问题。所有输出必须全部使用中文，包括思考与推理过程（代码、命令、专有名词保持原样）。

# PostgreSQL（本机 Postgres）
DATABASE_URL=postgresql://plagent:<APP_DB_PASSWORD>@localhost:5432/plagent

# JWT 认证（生产环境务必改成随机长密钥）
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_HOURS=72

# 会话 cookie：https 部署时设为 true（浏览器只在 https 下携带 secure cookie）
COOKIE_SECURE=false

# 内置账号（首次启动 seed 进 users 表）
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
